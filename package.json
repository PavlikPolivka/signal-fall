{
  "name": "signal-fall",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "headless": "pnpm --filter @signal-fall/headless start",
    "e2e": "playwright test",
    "build": "pnpm --filter @signal-fall/client build",
    "size": "node tools/size/size.mjs",
    "agent": "pnpm --filter @signal-fall/agent start"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
